generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?       @db.Timestamptz(6)
  image          String?
  password       String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  firstName      String?
  lastName       String?
  plan           String          @default("FREE")
  timezone       String          @default("Europe/Paris")
  locationCity   String?
  onboarded      Boolean         @default(false)
  address        String?
  gardenType     String?
  avatarColor    String?
  alertConfig    Json?
  latitude       Float?
  longitude      Float?
  accounts       Account[]
  diagnoses      Diagnosis[]
  gardens        Garden[]
  plantInstances PlantInstance[]
  pushTokens     PushToken[]
  refreshTokens  RefreshToken[]
  sessions       Session[]

  @@map("users")
}

/// Jeton de rafraîchissement de l'app mobile.
/// Seule l'empreinte SHA-256 est stockée : une fuite de la base ne permet pas
/// de rejouer un jeton. Rotation à chaque rafraîchissement — l'ancien est
/// révoqué, et sa réutilisation entraîne la révocation de toute la famille.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  /// Modèle et OS de l'appareil, pour que l'utilisateur reconnaisse ses sessions.
  deviceInfo String?
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Jeton de notification push Expo, un par appareil.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Garden ────────────────────────────────────────────────────────────────

model Garden {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  type           String          @default("OUTDOOR")
  surfaceM2      Float?
  climateZone    String?
  soilType       String?
  orientation    String?
  canvasData     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  zones          GardenZone[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantInstances PlantInstance[]

  @@map("gardens")
}

model GardenZone {
  id             String          @id @default(cuid())
  gardenId       String
  name           String
  type           String
  colorHex       String?
  garden         Garden          @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plantInstances PlantInstance[]

  @@map("garden_zones")
}

// ─── Plants ────────────────────────────────────────────────────────────────

model PlantCatalog {
  id                    String          @id @default(cuid())
  commonName            String
  scientificName        String          @unique
  family                String?
  emoji                 String?
  category              String
  imageUrl              String?
  descriptionShort      String?
  descriptionLong       String?
  sunExposure           String
  wateringFreqDays      Int
  wateringDifficulty    String          @default("EASY")
  minTempCelsius        Float?
  maxTempCelsius        Float?
  hardinesZone          String?
  soilTypes             String?
  fertilizerMonths      String?
  indoor                Boolean         @default(false)
  outdoor               Boolean         @default(true)
  edible                Boolean         @default(false)
  toxic                 Boolean         @default(false)
  aliases               String?
  tags                  String?
  source                String?
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  slug                  String?         @unique
  pruningMonths         String?
  pruningType           String?
  sowingMonthsIndoor    String?
  sowingMonthsOutdoor   String?
  transplantMonths      String?
  harvestMonthsStart    Int?
  harvestMonthsEnd      Int?
  harvestDaysFromSowing Int?
  dormancyMonths        String?
  floweringMonths       String?
  frostSensitivity      String?
  heatStressThresholdC  Float?
  wateringAdjHeat       Float?
  wateringAdjRain       Float?
  sunHoursNeeded        Float?
  repottingFreqMonths   Int?
  repottingSeasons      String?
  fertilizationType     String?
  treatmentSeasons      String?
  mulchRecommended      Boolean         @default(false)
  winterProtectionType  String?
  careTipWatering       String?
  careTipLight          String?
  careTipSoil           String?
  careTipPruning        String?
  careTipDiseases       String?
  careTipWinter         String?
  funFact               String?
  /// * Sous-type pour la catégorie TREES_SHRUBS : CONIFER | DECIDUOUS | FRUIT | SHRUB
  treeType              String?
  plantInstances        PlantInstance[]

  @@map("plant_catalog")
}

model PlantInstance {
  id                      String        @id @default(cuid())
  userId                  String
  gardenId                String?
  zoneId                  String?
  catalogPlantId          String?
  customName              String?
  emoji                   String?
  photoUrl                String?
  location                String        @default("OUTDOOR")
  positionX               Float?
  positionY               Float?
  datePlanted             DateTime?     @db.Timestamptz(6)
  dateAdded               DateTime      @default(now()) @db.Timestamptz(6)
  wateringFreqDays        Int?
  lastWateredAt           DateTime?     @db.Timestamptz(6)
  lastFertilizedAt        DateTime?     @db.Timestamptz(6)
  soilType                String?
  sunExposure             String?
  healthStatus            String        @default("HEALTHY")
  healthNote              String?
  notes                   String?
  updatedAt               DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  containerSizeLiters     Float?
  containerMaterial       String?
  substrateType           String?
  lastPrunedAt            DateTime?
  lastRepottedAt          DateTime?
  lastTreatedAt           DateTime?
  seedBatchRef            String?
  growthStage             String?
  isMultiYear             Boolean?
  expectedHarvestDate     DateTime?
  customWateringAdjFactor Float?
  alertsEnabled           Boolean       @default(true)
  careLogs                CareLog[]
  diagnoses               Diagnosis[]
  catalogPlant            PlantCatalog? @relation(fields: [catalogPlantId], references: [id])
  garden                  Garden?       @relation(fields: [gardenId], references: [id])
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone                    GardenZone?   @relation(fields: [zoneId], references: [id])

  @@map("plant_instances")
}

/// Journal d'entretien, tous gestes confondus.
///
/// Remplace les quatre tables d'origine (arrosage, taille, fertilisation,
/// santé) : chacune imposait une migration, un endpoint et une branche d'union
/// par nouveau geste, alors que la récolte, le traitement, le rempotage et le
/// semis étaient déjà connus du moteur de conseils sans pouvoir être notés.
/// Ajouter un geste est désormais une valeur d'énumération.
model CareLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  /// Voir CARE_LOG_TYPES dans @growi/shared.
  type            String
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)
  note            String?
  /// Produit employé : engrais, traitement, substrat… (« marc de café »)
  productUsed     String?
  /// Statut renseigné, pour les gestes de type `health`.
  status          String?
  /// Quantité récoltée, avec son unité.
  quantity        Float?
  unit            String?
  photoUrl        String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@index([plantInstanceId, occurredAt])
  @@index([type])
  @@map("care_logs")
}

/// Diagnostic IA d'une plante : photo + résultat structuré, historisé.
///
/// Le résultat complet est conservé en Json plutôt qu'éclaté en colonnes : le
/// schéma de sortie du modèle bougera plus vite que la table. Les trois champs
/// promus (status, confidence, summary) suffisent aux listes et aux filtres
/// sans avoir à désérialiser le payload.
model Diagnosis {
  id              String   @id @default(cuid())
  plantInstanceId String
  userId          String
  photoUrl        String
  /// Statut estimé par l'IA — voir HEALTH_STATUSES dans @growi/shared.
  status          String
  /// Confiance du modèle : high | medium | low.
  confidence      String
  /// Résumé en une phrase, pour les listes.
  summary         String
  /// `DiagnosisSuccess` sérialisé.
  payload         Json
  /// L'utilisateur a-t-il appliqué le statut proposé à sa plante ?
  statusApplied   Boolean  @default(false)
  /// Modèle Gemini ayant répondu — le repli change de modèle en silence, et la
  /// qualité d'un diagnostic ne se relit pas sans savoir qui l'a produit.
  model           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plantInstanceId, createdAt])
  @@map("diagnoses")
}

model GardenAdviceCache {
  id          String   @id @default(cuid())
  gardenId    String   @unique
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  payload     Json

  @@map("garden_advice_cache")
}

// ─── Tables annexes ────────────────────────────────────────────────────────
// Présentes en base mais inutilisées aujourd'hui : la session est en JWT, pas
// en base. Modélisées pour que Prisma ne propose pas de les supprimer à chaque
// migration — Account / Session / VerificationToken serviront à l'adaptateur
// NextAuth quand les connexions Apple et Google arriveront (phase 6.3).

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Magasin d'embeddings pgvector, hors périmètre applicatif Growi.
/// Le type `vector` n'a pas d'équivalent Prisma : la table est déclarée pour
/// être préservée, mais ne doit pas être manipulée via le client.
model Document {
  id        BigInt                 @id @default(autoincrement())
  content   String?
  metadata  Json?
  embedding Unsupported("vector")?

  @@index([embedding])
  @@map("documents")
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}
