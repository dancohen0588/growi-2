generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?
  password      String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  firstName     String?
  lastName      String?
  plan          String    @default("FREE")
  timezone      String    @default("Europe/Paris")
  locationCity  String?
  onboarded     Boolean   @default(false)
  address       String?
  gardenType    String?
  avatarColor   String?
  alertConfig   Json?
  latitude      Float?
  longitude     Float?
  /// Droits du compte — voir USER_ROLES dans @growi/shared : USER | ADMIN.
  role          String    @default("USER")
  /// Compte désactivé par un administrateur : connexion refusée, données conservées.
  disabledAt    DateTime? @db.Timestamptz(6)
  /// Dernière activité observée, toutes surfaces confondues.
  /// Mise à jour au plus une fois par heure (voir activity.service.ts).
  lastSeenAt    DateTime? @db.Timestamptz(6)

  // ── Communauté (opt-in) ──────────────────────────────────────────────────
  /// Pseudo public unique, 3 à 30 caractères `[a-z0-9_]`, normalisé en
  /// minuscules à l'écriture. Nul tant que le profil public n'est pas activé.
  /// Distinct de `name`/`firstName`, qui restent privés.
  handle             String?   @unique
  /// Présentation courte, ≤ 160 caractères.
  bio                String?
  /// Profil visible dans la communauté. Faux par défaut : l'opt-in est explicite,
  /// y compris pour les comptes créés avant la fonctionnalité.
  communityEnabled   Boolean   @default(false)
  communityEnabledAt DateTime? @db.Timestamptz(6)
  /// Position **floutée**, dérivée de latitude/longitude (voir community/geo.ts).
  /// C'est la seule position que la communauté manipule ; `latitude`/`longitude`
  /// ne sortent jamais d'une réponse API communautaire.
  fuzzyLat           Float?
  fuzzyLng           Float?
  /// Rayon préféré du fil local, en km — 5 | 20 | 50.
  communityRadiusKm  Int       @default(20)
  /// Compteurs dénormalisés : un fil affiche des dizaines de profils, et trois
  /// `COUNT` par carte ne tiendraient pas.
  followerCount      Int       @default(0)
  followingCount     Int       @default(0)
  postCount          Int       @default(0)

  following          Follow[]         @relation("follower")
  followers          Follow[]         @relation("following")
  blocksMade         Block[]          @relation("blocker")
  blocksReceived     Block[]          @relation("blocked")
  notifications      Notification[]
  reportsMade        Report[]         @relation("reporter")
  posts              Post[]
  postLikes          PostLike[]
  comments           Comment[]
  listings           Listing[]
  threadsAsRequester ListingThread[]  @relation("requester")
  listingMessages    ListingMessage[]

  accounts        Account[]
  activities      UserActivity[]
  adminActions    AdminAuditLog[]  @relation("actor")
  contactMessages ContactMessage[]
  conversations   Conversation[]
  diagnoses       Diagnosis[]
  tasks           PlantTask[]
  gardens         Garden[]
  plantInstances  PlantInstance[]
  pushTokens      PushToken[]
  refreshTokens   RefreshToken[]
  sessions        Session[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Une ligne par utilisateur, par jour UTC et par surface — c'est la seule
/// source des indicateurs d'actifs (DAU/WAU/MAU). Le web (session par cookies)
/// ne laissait jusqu'ici aucune trace exploitable.
///
/// Volume : au plus 2 lignes par utilisateur et par jour, purgeable au-delà de
/// 13 mois.
model UserActivity {
  userId  String
  /// `YYYY-MM-DD` UTC, même convention que IdentifyQuota.
  day     String
  /// web | mobile — voir ACTIVITY_SURFACES dans @growi/shared.
  surface String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, surface])
  @@index([day, surface])
  @@map("user_activities")
}

/// Journal des actions d'administration.
///
/// **Append-only** : aucune Server Action ne le modifie ni ne le supprime.
/// Un journal qu'on peut réécrire ne prouve rien. Il devient indispensable dès
/// qu'un compte peut éditer les données d'un autre.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  /// Voir ADMIN_ACTIONS dans lib/admin/audit.ts.
  action     String
  /// Type de la cible : user | contact_message | garden | plant_instance.
  targetType String
  targetId   String
  /// Avant/après ou paramètres. Jamais de mot de passe ni d'empreinte de jeton.
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  actor      User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

/// Message reçu depuis le formulaire de contact ou la liste d'attente bêta iOS.
///
/// Ces messages partaient en email et disparaissaient : rien n'en restait, ni
/// pour répondre, ni pour compter. Ils sont désormais **écrits avant l'envoi**,
/// et conservés même si l'email ne part pas.
model ContactMessage {
  id           String    @id @default(cuid())
  /// Voir CONTACT_MESSAGE_SOURCES dans @growi/shared.
  source       String    @default("contact")
  firstName    String?
  lastName     String?
  email        String
  phone        String?
  /// Valeur de CONTACT_SUBJECTS, ou `autre`.
  subject      String?
  otherSubject String?
  body         String
  /// Voir CONTACT_MESSAGE_STATUSES dans @growi/shared.
  status       String    @default("new")
  /// Compte Growi dont l'email correspond, rattaché à la réception.
  userId       String?
  /// Notes internes. Jamais envoyées à l'expéditeur.
  internalNote String?
  /// L'email de notification est-il parti ? `null` = pas envoyé.
  notifiedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  /// `SetNull` et non `Cascade` : supprimer un compte ne doit pas effacer
  /// l'historique du support, qui vaut aussi pour ceux qui restent.
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies ContactReply[]

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("contact_messages")
}

/// Réponse envoyée depuis l'admin, conservée telle qu'expédiée.
model ContactReply {
  id         String   @id @default(cuid())
  messageId  String
  authorId   String
  body       String
  /// Identifiant renvoyé par Resend, pour recouper en cas de doute.
  providerId String?
  sentAt     DateTime @default(now()) @db.Timestamptz(6)

  message ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, sentAt])
  @@map("contact_replies")
}

/// Jeton de rafraîchissement de l'app mobile.
/// Seule l'empreinte SHA-256 est stockée : une fuite de la base ne permet pas
/// de rejouer un jeton. Rotation à chaque rafraîchissement — l'ancien est
/// révoqué, et sa réutilisation entraîne la révocation de toute la famille.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  /// Modèle et OS de l'appareil, pour que l'utilisateur reconnaisse ses sessions.
  deviceInfo String?
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Jeton de notification push Expo, un par appareil.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Garden ────────────────────────────────────────────────────────────────

model Garden {
  id                String          @id @default(cuid())
  userId            String
  name              String
  description       String?
  type              String          @default("OUTDOOR")
  surfaceM2         Float?
  climateZone       String?
  soilType          String?
  orientation       String?
  canvasData        String?
  /// Jour `YYYY-MM-DD` où l'utilisateur a demandé « Ignorer pour aujourd'hui » :
  /// les actions du moteur dues ce jour-là sont masquées jusqu'au lendemain.
  /// Une date et non un booléen : elle se périme d'elle-même, sans tournée de
  /// nettoyage ni risque de laisser un jardin muet pour toujours.
  planningClearedOn String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  zones             GardenZone[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantInstances    PlantInstance[]

  @@map("gardens")
}

model GardenZone {
  id             String          @id @default(cuid())
  gardenId       String
  name           String
  type           String
  colorHex       String?
  garden         Garden          @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plantInstances PlantInstance[]

  @@map("garden_zones")
}

// ─── Plants ────────────────────────────────────────────────────────────────

model PlantCatalog {
  id                    String          @id @default(cuid())
  commonName            String
  scientificName        String          @unique
  family                String?
  emoji                 String?
  category              String
  imageUrl              String?
  descriptionShort      String?
  descriptionLong       String?
  sunExposure           String
  wateringFreqDays      Int
  wateringDifficulty    String          @default("EASY")
  minTempCelsius        Float?
  maxTempCelsius        Float?
  hardinesZone          String?
  soilTypes             String?
  fertilizerMonths      String?
  indoor                Boolean         @default(false)
  outdoor               Boolean         @default(true)
  edible                Boolean         @default(false)
  toxic                 Boolean         @default(false)
  aliases               String?
  tags                  String?
  source                String?
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  slug                  String?         @unique
  pruningMonths         String?
  pruningType           String?
  sowingMonthsIndoor    String?
  sowingMonthsOutdoor   String?
  transplantMonths      String?
  harvestMonthsStart    Int?
  harvestMonthsEnd      Int?
  harvestDaysFromSowing Int?
  dormancyMonths        String?
  floweringMonths       String?
  frostSensitivity      String?
  heatStressThresholdC  Float?
  wateringAdjHeat       Float?
  wateringAdjRain       Float?
  sunHoursNeeded        Float?
  repottingFreqMonths   Int?
  repottingSeasons      String?
  fertilizationType     String?
  treatmentSeasons      String?
  mulchRecommended      Boolean         @default(false)
  winterProtectionType  String?
  careTipWatering       String?
  careTipLight          String?
  careTipSoil           String?
  careTipPruning        String?
  careTipDiseases       String?
  careTipWinter         String?
  funFact               String?
  /// * Sous-type pour la catégorie TREES_SHRUBS : CONIFER | DECIDUOUS | FRUIT | SHRUB
  treeType              String?
  plantInstances        PlantInstance[]
  listings              Listing[]

  @@map("plant_catalog")
}

model PlantInstance {
  id                      String         @id @default(cuid())
  userId                  String
  gardenId                String?
  zoneId                  String?
  catalogPlantId          String?
  customName              String?
  emoji                   String?
  photoUrl                String?
  location                String         @default("OUTDOOR")
  positionX               Float?
  positionY               Float?
  datePlanted             DateTime?      @db.Timestamptz(6)
  dateAdded               DateTime       @default(now()) @db.Timestamptz(6)
  wateringFreqDays        Int?
  lastWateredAt           DateTime?      @db.Timestamptz(6)
  lastFertilizedAt        DateTime?      @db.Timestamptz(6)
  soilType                String?
  sunExposure             String?
  healthStatus            String         @default("HEALTHY")
  healthNote              String?
  notes                   String?
  updatedAt               DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  containerSizeLiters     Float?
  containerMaterial       String?
  substrateType           String?
  lastPrunedAt            DateTime?
  lastRepottedAt          DateTime?
  lastTreatedAt           DateTime?
  /// Posée par `logCare('harvest')`, comme les autres `last*At`. Sans elle,
  /// rien ne fermait la règle de récolte : elle ressortait chaque matin de
  /// toute la saison, en priorité haute, sans qu'aucun geste ne l'apaise.
  lastHarvestedAt         DateTime?      @db.Timestamptz(6)
  seedBatchRef            String?
  growthStage             String?
  isMultiYear             Boolean?
  expectedHarvestDate     DateTime?
  customWateringAdjFactor Float?
  alertsEnabled           Boolean        @default(true)
  careLogs                CareLog[]
  communityPosts          Post[]
  conversations           Conversation[]
  diagnoses               Diagnosis[]
  tasks                   PlantTask[]
  catalogPlant            PlantCatalog?  @relation(fields: [catalogPlantId], references: [id])
  garden                  Garden?        @relation(fields: [gardenId], references: [id])
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone                    GardenZone?    @relation(fields: [zoneId], references: [id])

  @@map("plant_instances")
}

/// Journal d'entretien, tous gestes confondus.
///
/// Remplace les quatre tables d'origine (arrosage, taille, fertilisation,
/// santé) : chacune imposait une migration, un endpoint et une branche d'union
/// par nouveau geste, alors que la récolte, le traitement, le rempotage et le
/// semis étaient déjà connus du moteur de conseils sans pouvoir être notés.
/// Ajouter un geste est désormais une valeur d'énumération.
model CareLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  /// Voir CARE_LOG_TYPES dans @growi/shared.
  type            String
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)
  note            String?
  /// Produit employé : engrais, traitement, substrat… (« marc de café »)
  productUsed     String?
  /// Statut renseigné, pour les gestes de type `health`.
  status          String?
  /// Quantité récoltée, avec son unité.
  quantity        Float?
  unit            String?
  photoUrl        String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@index([plantInstanceId, occurredAt])
  @@index([type])
  @@map("care_logs")
}

/// Diagnostic IA d'une plante : photo + résultat structuré, historisé.
///
/// Le résultat complet est conservé en Json plutôt qu'éclaté en colonnes : le
/// schéma de sortie du modèle bougera plus vite que la table. Les trois champs
/// promus (status, confidence, summary) suffisent aux listes et aux filtres
/// sans avoir à désérialiser le payload.
model Diagnosis {
  id              String    @id @default(cuid())
  plantInstanceId String
  userId          String
  photoUrl        String
  /// Statut estimé par l'IA — voir HEALTH_STATUSES dans @growi/shared.
  status          String
  /// Confiance du modèle : high | medium | low.
  confidence      String
  /// Résumé en une phrase, pour les listes.
  summary         String
  /// `DiagnosisSuccess` sérialisé.
  payload         Json
  /// L'utilisateur a-t-il appliqué le statut proposé à sa plante ?
  statusApplied   Boolean   @default(false)
  /// Modèle Gemini ayant répondu — le repli change de modèle en silence, et la
  /// qualité d'un diagnostic ne se relit pas sans savoir qui l'a produit.
  model           String?
  /// Quand les recommandations ont été transformées en tâches, `null` sinon.
  /// Fait aussi office de verrou d'idempotence : on ne planifie qu'une fois.
  tasksPlannedAt  DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  plantInstance PlantInstance  @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         PlantTask[]
  conversations Conversation[]

  @@index([plantInstanceId, createdAt])
  @@map("diagnoses")
}

/// Tâche persistée du planning — v1 : issue d'un diagnostic accepté.
///
/// Les actions du planning sont normalement *calculées* par le moteur de
/// règles à chaque évaluation. Une recommandation acceptée, elle, doit être
/// figée à sa date d'acceptation puis acquittée individuellement : elle ne
/// peut donc pas être une règle, d'où cette table. `source` prépare les
/// tâches saisies à la main, qui viendront s'y ranger sans migration.
model PlantTask {
  id                      String    @id @default(cuid())
  userId                  String
  plantInstanceId         String
  diagnosisId             String?
  /// Voir TASK_SOURCES dans @growi/shared : DIAGNOSIS | CHAT.
  source                  String    @default("DIAGNOSIS")
  /// ActionType de @growi/shared : arrosage | taille | … | autre.
  type                    String
  /// Consigne détaillée — l'action de la recommandation, telle quelle.
  label                   String
  /// Titre court de la carte du planning ; `label` en devient le détail.
  /// Abrégé depuis `label` pour les diagnostics d'avant son introduction.
  shortLabel              String
  /// Échéance `YYYY-MM-DD`, figée à la planification.
  dueDate                 String
  /// high | medium | low, mappé depuis urgent | soon | watch.
  priority                String
  doneAt                  DateTime? @db.Timestamptz(6)
  /// Retirée du planning par un diagnostic plus récent, sans être « faite ».
  /// Distinguer les deux importe : une tâche remplacée n'a pas à s'inscrire au
  /// journal de la plante, et elle reste lisible dans l'historique du
  /// diagnostic qui l'avait engendrée.
  supersededByDiagnosisId String?
  supersededAt            DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)

  plantInstance PlantInstance  @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// La tâche survit à la suppression de son diagnostic : elle a été acceptée
  /// pour elle-même, et la retirer du planning surprendrait l'utilisateur.
  diagnosis     Diagnosis?     @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([userId, doneAt, dueDate])
  @@index([plantInstanceId])
  @@map("plant_tasks")
}

/// Fil de discussion avec l'agent conversationnel, ancré sur une plante, un
/// diagnostic ou une action du planning.
///
/// Un seul fil par ancrage : rouvrir le même point d'entrée doit retrouver la
/// conversation, pas en ouvrir une nouvelle à côté.
model Conversation {
  id              String    @id @default(cuid())
  userId          String
  plantInstanceId String
  /// Voir CONVERSATION_KINDS dans @growi/shared : plant | diagnosis | action.
  kind            String
  diagnosisId     String?
  /// Tâche planifiée (`PlantTask.id`) quand l'action en vient.
  taskId          String?
  /// Id déterministe d'une action du moteur (`r1-watering-standard:<plantInstanceId>`).
  actionKey       String?
  /// L'action telle qu'elle était à l'ouverture. Les actions du moteur ne sont
  /// pas persistées et peuvent disparaître d'une évaluation à l'autre ; sans
  /// cette copie, le fil deviendrait illisible.
  actionSnapshot  Json?
  /// Clé d'unicité de l'ancrage : `plant:<id>`, `diagnosis:<id>`, `task:<id>`
  /// ou `action:<key>`. Calculée plutôt que déduite de trois colonnes
  /// optionnelles — Postgres tient deux NULL pour distincts, et un index
  /// unique sur des colonnes nullables laisserait ouvrir autant de fils
  /// « plante » qu'on veut.
  anchorKey       String
  /// En-tête du fil : nom de la plante, « Diagnostic du 3 sept. », « Tailler — Rosier ».
  title           String
  lastMessageAt   DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)
  /// Le fil survit à la suppression de son diagnostic ou de sa tâche : ce qui
  /// s'y est dit reste vrai, et `actionSnapshot` en garde le contexte.
  diagnosis     Diagnosis?    @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  task          PlantTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([userId, anchorKey])
  @@index([userId, lastMessageAt])
  @@index([plantInstanceId])
  @@map("conversations")
}

/// Un tour de conversation.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// Voir CHAT_ROLES dans @growi/shared : user | assistant.
  role           String
  content        String
  photoUrl       String?
  /// `ChatProposal[]` sérialisé — les propositions portées par ce message
  /// (assistant uniquement), avec leur état d'acceptation. C'est cette copie
  /// que le serveur relit pour exécuter une confirmation : le client n'envoie
  /// jamais que des identifiants.
  proposals      Json?
  /// Modèle Gemini ayant répondu — le repli change de modèle en silence, et la
  /// qualité d'une réponse ne se relit pas sans savoir qui l'a produite.
  model          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  /// Sert au quota journalier : messages `user` d'un compte sur une journée.
  @@index([userId, role, createdAt])
  @@map("messages")
}

model GardenAdviceCache {
  id          String   @id @default(cuid())
  gardenId    String   @unique
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  payload     Json

  @@map("garden_advice_cache")
}

// ─── Tables annexes ────────────────────────────────────────────────────────
// Présentes en base mais inutilisées aujourd'hui : la session est en JWT, pas
// en base. Modélisées pour que Prisma ne propose pas de les supprimer à chaque
// migration — Account / Session / VerificationToken serviront à l'adaptateur
// NextAuth quand les connexions Apple et Google arriveront (phase 6.3).

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Magasin d'embeddings pgvector, hors périmètre applicatif Growi.
/// Le type `vector` n'a pas d'équivalent Prisma : la table est déclarée pour
/// être préservée, mais ne doit pas être manipulée via le client.
model Document {
  id        BigInt                 @id @default(autoincrement())
  content   String?
  metadata  Json?
  embedding Unsupported("vector")?

  @@index([embedding])
  @@map("documents")
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Compteur d'identifications photo pour les visiteurs **non connectés**.
///
/// La page publique `/identifier` appelle Gemini sans compte : sans plafond,
/// une boucle suffirait à faire grimper la facture. Le compteur est en base et
/// non en mémoire — sur Vercel chaque instance a la sienne, et un plafond que
/// l'on contourne en changeant d'instance n'en est pas un.
///
/// `ipHash` est une empreinte SHA-256 de l'adresse, pas l'adresse : c'est une
/// pseudonymisation, pas un anonymat (une IPv4 se retrouve par force brute),
/// mais une fuite de table ne livre pas directement des adresses. Deux clés
/// réservées y cohabitent avec les empreintes : le plafond global du jour et
/// le seau des requêtes dont l'adresse est inconnue.
model IdentifyQuota {
  ipHash String @map("ip_hash")
  /// Jour UTC au format `YYYY-MM-DD` : la remise à zéro est un changement de ligne.
  day    String
  count  Int    @default(0)

  @@id([ipHash, day])
  @@index([day])
  @@map("identify_quotas")
}

// ─── Communauté ────────────────────────────────────────────────────────────

/// Abonnement **unilatéral et sans validation** : un profil public est public.
/// Demander une acceptation ajouterait une file d'attente à gérer pour une
/// valeur nulle tant que la base d'utilisateurs est petite.
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  /// « Qui me suit », dans l'ordre d'arrivée.
  @@index([followingId, createdAt])
  @@map("follows")
}

/// Blocage, appliqué **dans les deux sens** : le bloqué ne voit plus mes
/// contenus et ne peut plus m'écrire, et je ne vois plus les siens. Poser le
/// blocage rompt les abonnements existants ; le retirer ne les rétablit pas.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  /// Lecture symétrique : « qui m'a bloqué » filtre aussi mes lectures.
  @@index([blockedId])
  @@map("blocks")
}

/// Notification in-app. Le push, lui, est envoyé au moment de l'écriture et
/// n'est pas rejoué : cette table est un journal consultable, pas une file.
model Notification {
  id        String    @id @default(cuid())
  /// Destinataire.
  userId    String
  /// Voir NOTIFICATION_KINDS dans @growi/shared.
  kind      String
  /// Qui a déclenché. Volontairement **sans clé étrangère** : le texte affiché
  /// est figé dans `preview`, il n'y a donc rien à rejoindre pour afficher la
  /// ligne, et une notification survit à la suppression de son acteur.
  actorId   String?
  /// Cible du tap : { postId } | { listingId, threadId } | { userId }.
  target    Json
  /// Texte prêt à afficher, figé à l'écriture — l'acteur peut changer de pseudo
  /// et le contenu être supprimé, la notification doit rester lisible.
  preview   String
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sert la liste paginée comme le badge de non-lus.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Publication du fil communautaire.
model Post {
  id              String   @id @default(cuid())
  userId          String
  /// Plante mise en avant, facultative. `SetNull` : supprimer la plante ne doit
  /// pas emporter la publication, qui a sa vie propre — des cœurs, des
  /// commentaires — chez d'autres que son auteur.
  plantInstanceId String?
  /// Nom affiché, **figé à la publication**. La plante peut être renommée ou
  /// disparaître ; ce que les gens ont lu ne change pas.
  plantLabel      String?
  body            String
  /// 1 à 4 URLs Supabase Storage. Json plutôt qu'une table : rien n'interroge
  /// jamais une photo isolément.
  photos          Json
  /// Position **floutée**, recopiée de l'auteur au moment de la publication.
  /// Recopiée et non jointe : déménager ne doit pas déplacer après coup une
  /// photo prise dans l'ancien jardin.
  lat             Float
  lng             Float
  /// Dénormalisés : le fil affiche vingt cartes, et deux `COUNT` par carte ne
  /// tiendraient pas.
  likeCount       Int      @default(0)
  commentCount    Int      @default(0)
  /// Voir CONTENT_STATUSES : visible | hidden (modération, ou profil désactivé)
  /// | deleted.
  status          String   @default("visible")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantInstance PlantInstance? @relation(fields: [plantInstanceId], references: [id], onDelete: SetNull)
  likes         PostLike[]
  comments      Comment[]

  /// Les publications d'un compte, pour son profil public.
  @@index([userId, createdAt])
  /// Le fil : filtre sur `status`, puis tri antéchronologique.
  @@index([status, createdAt])
  @@map("posts")
}

/// Un cœur. Sans identifiant propre : la paire est la clé, ce qui rend le
/// « j'aime » idempotent par construction.
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  /// « Ai-je aimé ces vingt publications ? » en une requête.
  @@index([userId])
  @@map("post_likes")
}

/// Commentaire, **à plat** : pas de réponses imbriquées en v1.
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  /// Voir CONTENT_STATUSES.
  status    String   @default("visible")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}

/// Annonce de la bourse aux graines — don, échange ou recherche.
///
/// Pas de vente en v1 : l'échange gratuit de semences entre amateurs est
/// autorisé, la vente est encadrée par le catalogue officiel.
model Listing {
  id               String    @id @default(cuid())
  userId           String
  /// Voir LISTING_KINDS : give | swap | seek.
  kind             String
  /// Voir LISTING_CATEGORIES : seeds | plants | cuttings | harvest | tools.
  category         String
  title            String
  description      String?
  photoUrl         String?
  /// Espèce du catalogue si l'auteur l'a identifiée — prépare les filtres par
  /// espèce, sans les imposer aujourd'hui.
  catalogPlantId   String?
  /// Texte libre : « ~30 graines », « 3 plants ».
  quantity         String?
  /// Ce que l'auteur souhaite en retour, sur une annonce d'échange.
  wants            String?
  /// Voir LISTING_STATUSES.
  status           String    @default("active")
  /// Position **floutée**, recopiée de l'auteur à la publication — même
  /// raisonnement que sur `Post`.
  lat              Float
  lng              Float
  /// `createdAt` + 60 jours, prolongeable. Une bourse pleine d'annonces d'il y
  /// a huit mois ne vaut rien.
  expiresAt        DateTime  @db.Timestamptz(6)
  /// Dernier rappel d'expiration envoyé, pour ne pas le répéter chaque jour.
  expiryNotifiedAt DateTime? @db.Timestamptz(6)
  /// Dénormalisé : l'auteur voit le nombre d'intéressés sur sa propre annonce.
  threadCount      Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalog PlantCatalog?   @relation(fields: [catalogPlantId], references: [id], onDelete: SetNull)
  threads ListingThread[]

  /// La bourse : statut, puis filtre de catégorie, puis tri antéchronologique.
  @@index([status, category, createdAt])
  @@index([userId, createdAt])
  /// La tournée d'expiration : les annonces actives dont la date est passée.
  @@index([status, expiresAt])
  @@map("listings")
}

/// Un fil par (annonce, intéressé).
///
/// Distinct de `Conversation`, réservé au chat Growi et ancré sur une plante :
/// les mélanger forcerait des colonnes nullables des deux côtés et brouillerait
/// le quota IA, qui ne concerne que l'un des deux.
model ListingThread {
  id              String    @id @default(cuid())
  listingId       String
  /// Dénormalisé depuis `listing.userId`, pour indexer « mes fils » sans
  /// jointure : l'écran Messages mêle les deux rôles.
  ownerId         String
  requesterId     String
  lastMessageAt   DateTime? @db.Timestamptz(6)
  /// Dernière lecture de chacun, pour le badge de non-lus.
  ownerReadAt     DateTime? @db.Timestamptz(6)
  requesterReadAt DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  messages  ListingMessage[]

  /// Un seul fil par intéressé et par annonce : « Je suis intéressé » rouvre
  /// le sien plutôt que d'en empiler un nouveau.
  @@unique([listingId, requesterId])
  @@index([ownerId, lastMessageAt])
  @@index([requesterId, lastMessageAt])
  @@map("listing_threads")
}

model ListingMessage {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  body      String
  photoUrl  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  thread ListingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("listing_messages")
}

/// Signalement d'un contenu ou d'un compte.
///
/// L'unicité `(reporterId, targetType, targetId)` est ce qui donne son sens au
/// masquage automatique : le seuil compte des **personnes** distinctes, qu'un
/// seul signaleur acharné ne peut donc pas atteindre.
model Report {
  id           String    @id @default(cuid())
  reporterId   String
  /// Voir REPORT_TARGETS : post | comment | listing | message | user.
  targetType   String
  targetId     String
  /// Voir REPORT_REASONS.
  reason       String
  note         String?
  /// Voir REPORT_STATUSES : open | actioned | dismissed.
  status       String    @default("open")
  /// Administrateur ayant tranché. Sans clé étrangère, comme AdminAuditLog.actorId.
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  /// File de modération : les signalements ouverts, les plus anciens d'abord.
  @@index([status, createdAt])
  /// Compte des signalements distincts d'un contenu, pour le seuil de masquage.
  @@index([targetType, targetId])
  @@map("reports")
}
