datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  firstName     String?
  lastName      String?
  address       String?
  gardenType    String?
  avatarColor   String?
  alertConfig   Json?
  plan          String    @default("FREE")
  timezone      String    @default("Europe/Paris")
  locationCity  String?
  latitude      Float?
  longitude     Float?
  onboarded     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gardens        Garden[]
  plantInstances PlantInstance[]

  @@map("users")
}

// ─── Garden ────────────────────────────────────────────────────────────────

model Garden {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   @default("OUTDOOR")
  surfaceM2   Float?
  climateZone String?
  soilType    String?
  orientation String?
  canvasData  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zones          GardenZone[]
  plantInstances PlantInstance[]

  @@map("gardens")
}

model GardenZone {
  id       String  @id @default(cuid())
  gardenId String
  name     String
  type     String
  colorHex String?

  garden         Garden          @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plantInstances PlantInstance[]

  @@map("garden_zones")
}

// ─── Plants ────────────────────────────────────────────────────────────────

model PlantCatalog {
  id                 String   @id @default(cuid())
  slug               String?  @unique
  commonName         String
  scientificName     String   @unique
  family             String?
  emoji              String?
  category           String
  /** Sous-type pour la catégorie TREES_SHRUBS : CONIFER | DECIDUOUS | FRUIT | SHRUB */
  treeType           String?
  imageUrl           String?
  descriptionShort   String?
  descriptionLong    String?
  sunExposure        String
  wateringFreqDays   Int
  wateringDifficulty String   @default("EASY")
  minTempCelsius     Float?
  maxTempCelsius     Float?
  hardinesZone       String?
  soilTypes          String?
  fertilizerMonths   String?
  indoor             Boolean  @default(false)
  outdoor            Boolean  @default(true)
  edible             Boolean  @default(false)
  toxic              Boolean  @default(false)
  aliases            String?
  tags               String?
  source             String?

  // Calendrier cultural
  pruningMonths         String?
  pruningType           String?
  sowingMonthsIndoor    String?
  sowingMonthsOutdoor   String?
  transplantMonths      String?
  harvestMonthsStart    Int?
  harvestMonthsEnd      Int?
  harvestDaysFromSowing Int?
  dormancyMonths        String?
  floweringMonths       String?

  // Agro-climatologie
  frostSensitivity     String?
  heatStressThresholdC Float?
  wateringAdjHeat      Float?
  wateringAdjRain      Float?
  sunHoursNeeded       Float?

  // Entretien spécialisé
  repottingFreqMonths  Int?
  repottingSeasons     String?
  fertilizationType    String?
  treatmentSeasons     String?
  mulchRecommended     Boolean  @default(false)
  winterProtectionType String?

  // Care tips éditoriaux
  careTipWatering String?
  careTipLight    String?
  careTipSoil     String?
  careTipPruning  String?
  careTipDiseases String?
  careTipWinter   String?
  funFact         String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plantInstances PlantInstance[]

  @@map("plant_catalog")
}

model PlantInstance {
  id               String    @id @default(cuid())
  userId           String
  gardenId         String?
  zoneId           String?
  catalogPlantId   String?
  customName       String?
  emoji            String?
  photoUrl         String?
  location         String    @default("OUTDOOR")
  positionX        Float?
  positionY        Float?
  datePlanted      DateTime?
  dateAdded        DateTime  @default(now())
  wateringFreqDays Int?
  lastWateredAt    DateTime?
  lastFertilizedAt DateTime?
  soilType         String?
  sunExposure      String?
  healthStatus     String    @default("HEALTHY")
  healthNote       String?
  notes            String?

  // Contexte pot/substrat
  containerSizeLiters     Float?
  containerMaterial       String?
  substrateType           String?

  // Historique interventions
  lastPrunedAt            DateTime?
  lastRepottedAt          DateTime?
  lastTreatedAt           DateTime?

  // Données culturales
  seedBatchRef            String?
  growthStage             String?
  isMultiYear             Boolean?
  expectedHarvestDate     DateTime?
  customWateringAdjFactor Float?
  alertsEnabled           Boolean   @default(true)

  updatedAt        DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden          Garden?          @relation(fields: [gardenId], references: [id], onDelete: SetNull)
  zone            GardenZone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  catalogPlant    PlantCatalog?    @relation(fields: [catalogPlantId], references: [id])
  wateringLogs    WateringLog[]
  healthLogs      HealthLog[]
  pruningLogs     PruningLog[]
  fertilizingLogs FertilizingLog[]

  @@map("plant_instances")
}

model WateringLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  wateredAt       DateTime @default(now())
  note            String?

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@map("watering_logs")
}

model HealthLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  status          String
  note            String?
  photoUrl        String?
  loggedAt        DateTime @default(now())

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@map("health_logs")
}

model PruningLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  prunedAt        DateTime @default(now())
  pruningType     String?
  note            String?

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@map("pruning_logs")
}

model FertilizingLog {
  id              String   @id @default(cuid())
  plantInstanceId String
  fertilizedAt    DateTime @default(now())
  productUsed     String?
  note            String?

  plantInstance PlantInstance @relation(fields: [plantInstanceId], references: [id], onDelete: Cascade)

  @@map("fertilizing_logs")
}

model GardenAdviceCache {
  id          String   @id @default(cuid())
  gardenId    String   @unique
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  payload     Json

  @@map("garden_advice_cache")
}
