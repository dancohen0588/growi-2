# Auth
AUTH_SECRET=changeme-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Origine publique du site — sitemap, JSON-LD, et URLs absolues des images et
# des liens du blog servis au mobile par /api/v1/blog.
#
# **À renseigner en production**, où le domaine public doit faire foi.
# En développement, la laisser vide : l'API reprend alors l'origine par
# laquelle l'appel est arrivé, ce qui fait fonctionner le mobile qui joint le
# Mac par son IP locale. La fixer sur localhost casserait les images de l'app.
NEXT_PUBLIC_SITE_URL=

# Resend — envoi d'emails depuis le formulaire de contact
# Obtenir une clé sur https://resend.com. NE JAMAIS coller la vraie clé ici :
# ce fichier est versionné. La vraie valeur va dans .env.local, ignoré par git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Expéditeur et destinataire du formulaire de contact (facultatifs).
# Resend n'expédie que depuis un domaine vérifié chez lui : tant que
# growi-garden.fr ne l'est pas, pointer CONTACT_FROM_EMAIL sur un domaine qui
# l'est. Par défaut, les deux valent info@growi-garden.fr.
#
# CONTACT_FROM_EMAIL attend une adresse NUE (ex. info@growi-garden.fr) : le nom
# d'affichage est ajouté par le code, qui expédie en « Growi Contact <adresse> ».
# Y mettre soi-même un « Nom <adresse> » produirait un en-tête malformé, que
# Resend refuse.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Gemini — identification de plantes par vision (Gemini 2.5 Flash)
# Obtenir une clé sur https://aistudio.google.com/apikey (tier gratuit)
GEMINI_API_KEY=

# Supabase Storage — photos déposées par les utilisateurs (bucket `plant-photos`)
# La clé de service ne quitte jamais le serveur : elle contourne RLS.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — protège /api/cron/daily-reminders, appelée chaque matin.
# Chaîne aléatoire longue ; Vercel l'envoie en `Authorization: Bearer <secret>`.
CRON_SECRET=

# ── Observabilité ──────────────────────────────────────────────────────────
#
# Sentry (erreurs et traces). Ces variables sont posées dans Vercel, pas ici :
# en local elles restent vides et **rien n'est envoyé**, ce qui est voulu — un
# console.error de développement n'a pas à consommer le quota mensuel.
#
# Le DSN n'est pas un secret (il voyage dans chaque événement depuis le
# navigateur) ; le jeton d'authentification, si : il sert à téléverser les
# source maps au build et ne doit exister que dans Vercel.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=growi-web
SENTRY_AUTH_TOKEN=

# PostHog (analyse produit) — passes C et D, pas encore branché.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=

# Jeton de la route de vérification /api/v1/debug/sentry, temporaire (elle
# part à la fin de la Friends & Family). Sans cette variable, la route répond
# 404 : c'est le cas par défaut, y compris en production.
DEBUG_TOKEN=

# Connexion Apple et Google — audiences acceptées des jetons d'identité.
#
# Ce ne sont PAS des secrets : ces identifiants voyagent dans chaque requête
# d'autorisation et sont lisibles dans le binaire de l'app. Mais ils sont
# indispensables : sans eux, n'importe quelle application tierce pourrait faire
# ouvrir une session Growi avec les jetons qu'elle obtient pour elle-même.
#
# Plusieurs valeurs se séparent par des virgules. Une variable vide rend la
# route correspondante indisponible (503) plutôt que permissive.
#
# Apple : l'identifiant de bundle de l'app.
APPLE_CLIENT_IDS=app.growi.mobile
# Google : un identifiant client par plateforme (iOS, Android, et le web s'il
# vient un jour), pris dans la console Google Cloud.
GOOGLE_CLIENT_IDS=
