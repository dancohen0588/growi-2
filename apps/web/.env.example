# Auth
AUTH_SECRET=changeme-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Origine publique du site — sitemap, JSON-LD, et URLs absolues des images et
# des liens du blog servis au mobile par /api/v1/blog.
#
# **À renseigner en production**, où le domaine public doit faire foi.
# En développement, la laisser vide : l'API reprend alors l'origine par
# laquelle l'appel est arrivé, ce qui fait fonctionner le mobile qui joint le
# Mac par son IP locale. La fixer sur localhost casserait les images de l'app.
NEXT_PUBLIC_SITE_URL=

# Resend — envoi d'emails depuis le formulaire de contact
# Obtenir une clé sur https://resend.com. NE JAMAIS coller la vraie clé ici :
# ce fichier est versionné. La vraie valeur va dans .env.local, ignoré par git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Expéditeur et destinataire du formulaire de contact (facultatifs).
# Resend n'expédie que depuis un domaine vérifié chez lui : tant que growi.app
# ne l'est pas, pointer CONTACT_FROM_EMAIL sur un domaine qui l'est.
# Par défaut, les deux valent contact@growi.app.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Gemini — identification de plantes par vision (Gemini 2.5 Flash)
# Obtenir une clé sur https://aistudio.google.com/apikey (tier gratuit)
GEMINI_API_KEY=

# Supabase Storage — photos déposées par les utilisateurs (bucket `plant-photos`)
# La clé de service ne quitte jamais le serveur : elle contourne RLS.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — protège /api/cron/daily-reminders, appelée chaque matin.
# Chaîne aléatoire longue ; Vercel l'envoie en `Authorization: Bearer <secret>`.
CRON_SECRET=
