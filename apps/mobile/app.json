{
  "expo": {
    "name": "Growi",
    "slug": "growi",
    "owner": "growi-plant",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "growi",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9F7E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.growi.mobile"
    },
    "android": {
      "package": "app.growi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F9F7E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Growi utilise ta position pour la météo de ton jardin et les conseils d'arrosage."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Growi utilise l'appareil photo pour identifier tes plantes.",
          "photosPermission": "Growi accède à tes photos pour identifier une plante à partir d'un cliché existant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
